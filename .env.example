# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.
# Giá trị mặc định dưới đây là cấu hình đã dùng cho group_project/evaluation/RESULT.md.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
# Mỗi provider/model có collection riêng; đổi embedding thì chạy lại task4.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Chỉ dùng cho gemini (output_dimensionality).
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# Thư mục ChromaDB. Trên WSL nên để trong filesystem Linux, không để trên /mnt/<ổ>.
CHROMA_DIR=~/.cache/hanoi-rag/chroma_db

# Optional services. PageIndex fallback chỉ chạy khi có key và đã upload:
#   python -m src.task8_pageindex_vectorless
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh cho text-embedding-3-small: golden 0.471–0.737, ngoài domain 0.254–0.421.
# Đổi embedding model thì phải hiệu chỉnh lại (python -m src.task9_retrieval_pipeline).
SCORE_THRESHOLD=0.45

# Chỉ dùng khi máy gặp lỗi chứng chỉ với website nguồn; mặc định phải là 0.
ALLOW_INSECURE_SSL=0
